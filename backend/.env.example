# Copy to .env and fill in. Never commit the real .env.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# LOG_FILE=logs/api.log

# --- Database ---------------------------------------------------------------
# Must use an async driver (postgresql+asyncpg:// or sqlite+aiosqlite://).
#
# Supabase: dashboard -> Connect -> Session pooler string, then change the
# scheme from postgresql:// to postgresql+asyncpg://
#   DATABASE_URL=postgresql+asyncpg://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (@ -> %40, : -> %3A, ...).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharma
DB_ECHO=false
CREATE_TABLES_ON_STARTUP=true
# asyncpg prepared-statement cache; auto-disabled on Supabase's transaction
# pooler (port 6543). Only set this to override the automatic behavior.
# DB_STATEMENT_CACHE_SIZE=0

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Sentiment --------------------------------------------------------------
# lexicon = no downloads (default); finbert = needs requirements-ml.txt
SENTIMENT_BACKEND=lexicon
FINBERT_MODEL=ProsusAI/finbert

# --- Integrations -----------------------------------------------------------
# The SEC blocks anonymous traffic: put a real contact address here.
SEC_USER_AGENT=Your Company Name your.email@example.com
# Get keys at https://finnhub.io and https://www.alphavantage.co.
# Their scheduler jobs only register when the key is set.
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
SEC_INGEST_INTERVAL_MINUTES=30
SEC_INGEST_BATCH_SIZE=25
TICKER_PUSH_INTERVAL_SECONDS=10
DATA_RETENTION_DAYS=365

# Finnhub free tier: ~60 calls/min. 50 tickers per 5-minute run fits easily.
FINNHUB_NEWS_INTERVAL_MINUTES=5
FINNHUB_BATCH_SIZE=50
FINNHUB_LOOKBACK_DAYS=3

# Alpha Vantage is REST-only (no streaming), so quotes are polled. CHECK YOUR
# PLAN'S QUOTA: free tiers have been as tight as a few dozen requests per DAY,
# which this 60-second job would exhaust in minutes. On such a plan set 3600+.
ALPHA_VANTAGE_INTERVAL_SECONDS=60
ALPHA_VANTAGE_BATCH_SIZE=5

# --- Finnhub live trade stream ----------------------------------------------
# The only true real-time price source: a WebSocket of trade ticks. Starts
# automatically when FINNHUB_API_KEY is set.
FINNHUB_STREAM_ENABLED=true
# Plans cap concurrent symbol subscriptions; only watched tickers subscribe.
FINNHUB_STREAM_MAX_SYMBOLS=50
# Ticks are coalesced to at most one browser message per symbol per flush.
FINNHUB_STREAM_FLUSH_SECONDS=1.0
FINNHUB_STREAM_RESYNC_SECONDS=5.0

# --- Notification channels ---------------------------------------------------
# Alerts deliver in-app (WebSocket) always. These add external channels; each
# activates only when configured, and an unconfigured one logs and is skipped.
# Slack: Incoming Webhooks -> add to workspace -> copy the URL.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# SMTP (Gmail needs an App Password, not your account password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_USE_TLS=true
# EMAIL_FROM=alerts@example.com
# EMAIL_TO=you@example.com,desk@example.com

# Cap on how long one outbound notification may take.
NOTIFICATION_TIMEOUT_SECONDS=10
