# Copy to .env and fill in. Never commit the real .env.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# LOG_FILE=logs/api.log

# --- Database ---------------------------------------------------------------
# Must use an async driver. Supabase/Cloud SQL example:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharma
DB_ECHO=false
CREATE_TABLES_ON_STARTUP=true

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Sentiment --------------------------------------------------------------
# lexicon = no downloads (default); finbert = needs requirements-ml.txt
SENTIMENT_BACKEND=lexicon
FINBERT_MODEL=ProsusAI/finbert

# --- Integrations -----------------------------------------------------------
# The SEC blocks anonymous traffic: put a real contact address here.
SEC_USER_AGENT=Your Company Name your.email@example.com
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
SEC_INGEST_INTERVAL_MINUTES=30
SEC_INGEST_BATCH_SIZE=25
TICKER_PUSH_INTERVAL_SECONDS=10
DATA_RETENTION_DAYS=365
